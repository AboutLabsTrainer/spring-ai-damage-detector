<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>de.aboutlabs</groupId>
    <artifactId>damage-detector</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>damage-detector</name>
    <description>Batch inspection of transistor images via Jev (OpenRouter Decisions API)</description>

    <properties>
        <java.version>21</java.version>
        <!--
            OQ-6, verified 2026-11-06 on Maven Central and by running each on JUnit 6.0.3, the version Boot 4.1.2 manages.
            Cucumber: built against JUnit 6.1.3, no release targets 6.0; 7.x targets JUnit 5.
            WireMock: newest stable, 4.x is still beta. Keep equal to the wiremock/wiremock image tag.
            ArchUnit: newest 1.4.x (ADR-006).
            PIT and its JUnit 5 plugin: newest, verified on JUnit 6.0.3. Run on demand (mutation job, crafter), not bound to verify.
        -->
        <cucumber.version>8.0.4</cucumber.version>
        <wiremock.version>3.13.2</wiremock.version>
        <archunit.version>1.4.2</archunit.version>
        <pitest.version>1.30.2</pitest.version>
        <pitest-junit5-plugin.version>1.2.3</pitest-junit5-plugin.version>
        <!-- Which acceptance scenarios run: @pending stays out until DELIVER enables it, one at a time. -->
        <acceptance.inprocess.tags>not @pending and not @driving_adapter and not @container</acceptance.inprocess.tags>
        <!--
            PIT scope. CI narrows it to the changed classes with -DtargetClasses; the excludedClasses below always apply.
            Gated: domain, jev, cli logic and OutputFolder (classes with direct JUnit tests, user decision 2026-11-06).
        -->
        <targetClasses>de.aboutlabs.damagedetector.*</targetClasses>
        <acceptance.realprocess.tags>@driving_adapter and not @pending and not @container</acceptance.realprocess.tags>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.cucumber</groupId>
                <artifactId>cucumber-bom</artifactId>
                <version>${cucumber.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-suite</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-java</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-junit-platform-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-picocontainer</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <version>${wiremock.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <cucumber.filter.tags>${acceptance.inprocess.tags}</cucumber.filter.tags>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <!-- @driving_adapter scenarios start the repackaged jar, which only exists after the package phase. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <systemPropertyVariables>
                        <cucumber.filter.tags>${acceptance.realprocess.tags}</cucumber.filter.tags>
                        <detector.jar>${project.build.directory}/${project.build.finalName}.jar</detector.jar>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <!-- Mutation gate: ./mvnw test-compile org.pitest:pitest-maven:mutationCoverage -->
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <version>${pitest.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-junit5-plugin</artifactId>
                        <version>${pitest-junit5-plugin.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <targetTests>
                        <param>de.aboutlabs.damagedetector.*</param>
                    </targetTests>
                    <excludedClasses>
                        <!-- Wiring only. -->
                        <param>de.aboutlabs.damagedetector.DamageDetectorApplication</param>
                        <param>de.aboutlabs.damagedetector.DetectorConfiguration</param>
                        <param>de.aboutlabs.damagedetector.DetectorProperties*</param>
                        <!-- Covered only by Cucumber scenarios, which PIT does not count. -->
                        <param>de.aboutlabs.damagedetector.DetectorLauncher*</param>
                        <param>de.aboutlabs.damagedetector.LogSink</param>
                        <param>de.aboutlabs.damagedetector.batch.*</param>
                        <param>de.aboutlabs.damagedetector.evaluate.*</param>
                        <param>de.aboutlabs.damagedetector.probe.*</param>
                        <param>de.aboutlabs.damagedetector.inspection.Inspector*</param>
                        <param>de.aboutlabs.damagedetector.inspection.ImageFolder*</param>
                        <param>de.aboutlabs.damagedetector.cli.DetectorCommand*</param>
                    </excludedClasses>
                    <!-- JUnit tests only: the Cucumber suites are slow, the architecture rules kill nothing. -->
                    <excludedTestClasses>
                        <param>de.aboutlabs.damagedetector.acceptance.*</param>
                        <param>de.aboutlabs.damagedetector.architecture.*</param>
                    </excludedTestClasses>
                    <mutationThreshold>80</mutationThreshold>
                    <threads>4</threads>
                    <timestampedReports>false</timestampedReports>
                    <outputFormats>
                        <param>HTML</param>
                        <param>XML</param>
                    </outputFormats>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
